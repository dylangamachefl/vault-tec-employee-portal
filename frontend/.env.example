# Frontend environment variables
# Copy to .env.local (gitignored) and fill in values.

# API base URL. Leave empty to use the Vite dev proxy (/api → localhost:8000).
# In production, set to the absolute URL of your deployed FastAPI backend.
# Example: VITE_API_URL=https://vault-tec-api.onrender.com/api
VITE_API_URL=
